# ============================================================
# ESP32 NIDS — files that must NOT go to GitHub
# ============================================================

# --- OS / editor ---
.DS_Store
.AppleDouble
.LSOverride
.directory
Thumbs.db
ehthumbs.db
Desktop.ini
*~
*.swp
*.swo
*.bak
*.tmp
*.user
*.workspace
*.suo
*.sln.docstates

# --- Runtime / local state ---
*.log
*.log.*
captures/
logs/
live_state.json
data/live_state.json
data/live_state.json.tmp

# --- Datasets (keep local; share big sets via Google Drive) ---
data/raw/**
data/windows/**
!data/raw/.gitkeep
!data/windows/.gitkeep
!data/README.md
nids_dataset_*.csv
nids_windows_*.csv
*.csv

# --- Secrets (never push) ---
*login*
*password*
*.pem
*.key
.env
.env.*
archive/raspberry*
archive/**/*login*

# --- Archive: keep only README pointers, not old code / secrets ---
archive/**
!archive/README.md
!archive/duplicates/
!archive/duplicates/README.md

# --- ESP-IDF build (everyone generates locally) ---
**/build/
build/
*.o
*.a
*.out
*.exe
*.bin
*.elf
*.map
flasher_args.json
sdkconfig
sdkconfig.old
managed_components/
.espressif/
/components/.idf/
**/components/.idf/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
compile_commands.json

# --- Python ---
*.pyc
*.pyo
*.pyd
__pycache__/
*.egg-info/
dist/
venv/
.venv/
env/

# --- IDE / language servers (local) ---
.clangd/
.ccls-cache/
# Uncomment if you do not want to share IDE settings:
# .vscode/
# .devcontainer/

# --- Optional: large report binaries (prefer Drive) ---
# docs/**/*.pdf
