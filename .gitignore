# ============================================================
# ESP32 NIDS — files that must NOT go to GitHub
# ============================================================

# --- OS / editor ---
.DS_Store
.AppleDouble
.LSOverride
.directory
Thumbs.db
ehthumbs.db
Desktop.ini
*~
*.swp
*.swo
*.bak
*.tmp
*.user
*.workspace
*.suo
*.sln.docstates

# --- Runtime / local state ---
*.log
*.log.*
captures/
logs/
live_state.json
data/live_state.json
data/live_state.json.tmp

# --- Datasets: ignore captures by default; whitelist locked baselines ---
data/raw/*
data/windows/*
data/archive/
!data/raw/.gitkeep
!data/windows/.gitkeep
!data/README.md
!data/archive/README.md
# Collector dumps outside data/ (and anything else named like this)
nids_dataset_*.csv
nids_windows_*.csv
*.csv
# Phase A locked baseline (reproduce advisor / paper numbers)
!data/raw/nids_dataset_20260805_003226.csv
!data/windows/nids_windows_20260805_003226.csv

# --- Secrets (never push) ---
*login*
*password*
*.pem
*.key
.env
.env.*
archive/raspberry*
archive/**/*login*
note/.github_token
# Personal packing lists / home checklist — not for teammates
note/private/

# --- Archive: keep only README pointers, not old code / secrets ---
archive/**
!archive/README.md
!archive/duplicates/
!archive/duplicates/README.md

# --- ESP-IDF build (everyone generates locally) ---
**/build/
build/
*.o
*.a
*.out
*.exe
*.bin
*.elf
*.map
flasher_args.json
sdkconfig
sdkconfig.old
managed_components/
.espressif/
/components/.idf/
**/components/.idf/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
compile_commands.json

# --- Python ---
*.pyc
*.pyo
*.pyd
__pycache__/
*.egg-info/
dist/
venv/
.venv/
env/

# --- IDE / language servers (local — do not share) ---
.vscode/
.clangd
.clangd/
.ccls-cache/
.devcontainer/
.idea/
*.code-workspace

# --- Optional: large report binaries (prefer Drive) ---
# docs/**/*.pdf
